{"title":"","date":"2026-05-28T03:09:35.690Z","source":"index.html","raw":"<style>\n  .home-wrapper {\n    position: relative;\n    margin: -40px -20px -20px;\n    min-height: calc(100vh - 60px);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n  }\n\n  #particles-canvas {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    z-index: 0;\n    pointer-events: none;\n  }\n\n  .hero {\n    position: relative;\n    z-index: 1;\n    text-align: center;\n    padding: 100px 20px 60px;\n    max-width: 800px;\n    width: 100%;\n  }\n\n  .hero-avatar {\n    width: 110px;\n    height: 110px;\n    border-radius: 50%;\n    margin-bottom: 24px;\n    border: 3px solid rgba(200, 200, 200, 0.4);\n    padding: 4px;\n    background: rgba(255, 255, 255, 0.8);\n    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\n  }\n  .hero-avatar:hover {\n    transform: scale(1.08) rotate(3deg);\n    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);\n  }\n\n  .hero h1 {\n    font-size: 3em;\n    margin-bottom: 16px;\n    font-weight: 700;\n    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    letter-spacing: -1px;\n  }\n\n  .hero .subtitle {\n    font-size: 1.25em;\n    color: #777;\n    margin-bottom: 40px;\n    font-style: italic;\n    min-height: 1.6em;\n  }\n\n  #typing-text {\n    display: inline-block;\n    white-space: nowrap;\n    min-width: 18em;\n    text-align: center;\n  }\n\n  .typing-cursor {\n    display: inline-block;\n    width: 2px;\n    height: 1.1em;\n    background: #888;\n    margin-left: 3px;\n    animation: blink 1s infinite;\n    vertical-align: text-bottom;\n  }\n  @keyframes blink {\n    0%, 100% { opacity: 1; }\n    50% { opacity: 0; }\n  }\n\n  .hero .nav-cards {\n    display: flex;\n    justify-content: center;\n    gap: 18px;\n    flex-wrap: wrap;\n    margin-bottom: 32px;\n  }\n  .hero .nav-card {\n    display: block;\n    width: 145px;\n    padding: 26px 18px;\n    border-radius: 16px;\n    text-decoration: none;\n    color: inherit;\n    background: rgba(255, 255, 255, 0.35);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.45);\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.6);\n    transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n  }\n  .hero .nav-card:hover {\n    transform: translateY(-6px) scale(1.03);\n    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.8);\n    background: rgba(255, 255, 255, 0.5);\n    border-color: rgba(255, 255, 255, 0.7);\n  }\n  .hero .nav-card .icon {\n    font-size: 2em;\n    margin-bottom: 10px;\n    transition: transform 0.3s ease;\n  }\n  .hero .nav-card:hover .icon {\n    transform: scale(1.15);\n  }\n  .hero .nav-card .label {\n    font-size: 0.95em;\n    font-weight: 600;\n  }\n\n  .social-links {\n    display: flex;\n    justify-content: center;\n    gap: 14px;\n  }\n  .social-links a {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 42px;\n    height: 42px;\n    border-radius: 50%;\n    background: rgba(255, 255, 255, 0.3);\n    backdrop-filter: blur(10px);\n    border: 1px solid rgba(255, 255, 255, 0.4);\n    color: #555;\n    text-decoration: none;\n    transition: all 0.3s ease;\n    font-size: 1.1em;\n  }\n  .social-links a:hover {\n    transform: translateY(-4px);\n    background: rgba(255, 255, 255, 0.55);\n    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);\n    color: #333;\n  }\n\n  .scroll-hint {\n    position: absolute;\n    bottom: 24px;\n    left: 50%;\n    transform: translateX(-50%);\n    z-index: 1;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    color: #999;\n    font-size: 0.8em;\n    animation: bounce 2.2s infinite;\n    cursor: pointer;\n    text-decoration: none;\n    transition: color 0.3s;\n  }\n  .scroll-hint:hover {\n    color: #666;\n  }\n  .scroll-hint i {\n    font-size: 1.3em;\n    margin-top: 4px;\n  }\n  @keyframes bounce {\n    0%, 100% { transform: translateX(-50%) translateY(0); }\n    50% { transform: translateX(-50%) translateY(-10px); }\n  }\n\n  .intro-section {\n    position: relative;\n    z-index: 1;\n    max-width: 700px;\n    width: 100%;\n    padding: 60px 24px 40px;\n    text-align: center;\n    margin: 0 auto;\n  }\n  .intro-section h2 {\n    font-size: 1.7em;\n    margin-bottom: 18px;\n    font-weight: 600;\n    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n  .intro-section p {\n    font-size: 1.05em;\n    line-height: 1.8;\n    color: #666;\n    margin-bottom: 10px;\n  }\n\n  /* 深色模式 */\n  html[theme=\"dark\"] .hero h1,\n  html[theme=\"dark\"] .intro-section h2 {\n    background: linear-gradient(135deg, #8b9dc3 0%, #a78bfa 100%);\n    -webkit-background-clip: text;\n    background-clip: text;\n  }\n  html[theme=\"dark\"] .hero .subtitle {\n    color: #aaa;\n  }\n  html[theme=\"dark\"] .hero-avatar {\n    background: rgba(40, 40, 40, 0.8);\n    border-color: rgba(255, 255, 255, 0.15);\n  }\n  html[theme=\"dark\"] .hero .nav-card {\n    background: rgba(30, 30, 30, 0.4);\n    border-color: rgba(255, 255, 255, 0.08);\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.05);\n  }\n  html[theme=\"dark\"] .hero .nav-card:hover {\n    background: rgba(50, 50, 50, 0.55);\n    border-color: rgba(255, 255, 255, 0.15);\n    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.1);\n  }\n  html[theme=\"dark\"] .social-links a {\n    background: rgba(30, 30, 30, 0.4);\n    border-color: rgba(255, 255, 255, 0.08);\n    color: #bbb;\n  }\n  html[theme=\"dark\"] .social-links a:hover {\n    background: rgba(50, 50, 50, 0.6);\n    color: #eee;\n  }\n  html[theme=\"dark\"] .intro-section p {\n    color: #aaa;\n  }\n  html[theme=\"dark\"] .scroll-hint {\n    color: #888;\n  }\n  html[theme=\"dark\"] .scroll-hint:hover {\n    color: #bbb;\n  }\n\n  /* 响应式 */\n  @media (max-width: 600px) {\n    .home-wrapper {\n      margin: -30px -15px -15px;\n      min-height: calc(100vh - 50px);\n    }\n    .hero {\n      padding: 80px 16px 50px;\n    }\n    .hero h1 {\n      font-size: 2.2em;\n    }\n    .hero .subtitle {\n      font-size: 1.05em;\n    }\n    .hero .nav-card {\n      width: 120px;\n      padding: 20px 14px;\n      border-radius: 14px;\n    }\n    .hero-avatar {\n      width: 90px;\n      height: 90px;\n    }\n    .intro-section {\n      padding: 40px 20px 30px;\n    }\n    .intro-section h2 {\n      font-size: 1.4em;\n    }\n  }\n</style>\n\n<div class=\"home-wrapper\">\n  <canvas id=\"particles-canvas\"></canvas>\n\n  <div class=\"hero\">\n    <img class=\"hero-avatar\" src=\"/images/favicon1.webp\" alt=\"avatar\">\n    <h1>你好，我是 Weii</h1>\n    <p class=\"subtitle\" id=\"typing-text\"><span class=\"typing-cursor\"></span></p>\n\n    <div class=\"nav-cards\">\n      <a class=\"nav-card\" href=\"/blog\">\n        <div class=\"icon\">📝</div>\n        <div class=\"label\">博客</div>\n      </a>\n      <a class=\"nav-card\" href=\"/categories\">\n        <div class=\"icon\">📂</div>\n        <div class=\"label\">分类</div>\n      </a>\n      <a class=\"nav-card\" href=\"/tags\">\n        <div class=\"icon\">🏷️</div>\n        <div class=\"label\">标签</div>\n      </a>\n      <a class=\"nav-card\" href=\"/about\">\n        <div class=\"icon\">🙋</div>\n        <div class=\"label\">关于</div>\n      </a>\n    </div>\n\n  </div>\n\n  <a class=\"scroll-hint\" href=\"#intro\" onclick=\"event.preventDefault();document.getElementById('intro').scrollIntoView({behavior:'smooth'})\">\n    <span>向下滚动</span>\n    <i class=\"fa-solid fa-chevron-down\"></i>\n  </a>\n</div>\n\n<div class=\"intro-section\" id=\"intro\">\n  <h2>春江花月夜</h2>\n  <p>春江潮水连海平，海上明月共潮生。</p>\n  <p>滟滟随波千万里，何处春江无月明。</p>\n  <p>江流宛转绕芳甸，月照花林皆似霰。</p>\n  <p>空里流霜不觉飞，汀上白沙看不见。</p>\n  <p>江天一色无纤尘，皎皎空中孤月轮。</p>\n  <p>江畔何人初见月，江月何年初照人。</p>\n  <p>人生代代无穷已，江月年年望相似。</p>\n  <p>不知江月待何人，但见长江送流水。</p>\n  <p>白云一片去悠悠，青枫浦上不胜愁。</p>\n  <p>谁家今夜扁舟子，何处相思明月楼。</p>\n  <p>可怜楼上月徘徊，应照离人妆镜台。</p>\n  <p>玉户帘中卷不去，捣衣砧上拂还来。</p>\n  <p>此时相望不相闻，愿逐月华流照君。</p>\n  <p>鸿雁长飞光不度，鱼龙潜跃水成文。</p>\n  <p>昨夜闲潭梦落花，可怜春半不还家。</p>\n  <p>江水流春去欲尽，江潭落月复西斜。</p>\n  <p>斜月沉沉藏海雾，碣石潇湘无限路。</p>\n  <p>不知乘月几人归，落花摇情满江树。</p>\n</div>\n\n<script>\n  (function() {\n    // 打字机效果 - 优化版\n    const texts = [\"东边日出西边雨,道是无晴却有晴\", \"记录编程、技术与生活的点滴\"];\n    let textIndex = 0;\n    let charIndex = 0;\n    let isDeleting = false;\n    const typingElement = document.getElementById('typing-text');\n  \n    function type() {\n      const currentText = texts[textIndex];\n        \n      if (isDeleting) {\n        charIndex--;\n      } else {\n        charIndex++;\n      }\n        \n      typingElement.innerHTML = currentText.substring(0, charIndex) + '<span class=\"typing-cursor\"></span>';\n  \n      // 根据情况设置不同的速度\n      let typeSpeed;\n        \n      if (!isDeleting && charIndex === currentText.length) {\n        // 打字完成,暂停后开始删除\n        typeSpeed = 2000;\n        setTimeout(() => {\n          isDeleting = true;\n          type();\n        }, typeSpeed);\n        return;\n      } else if (isDeleting && charIndex === 0) {\n        // 删除完成,切换到下一段文字\n        typeSpeed = 500;\n        setTimeout(() => {\n          isDeleting = false;\n          textIndex = (textIndex + 1) % texts.length;\n          type();\n        }, typeSpeed);\n        return;\n      }\n        \n      // 打字速度:80ms,删除速度:40ms\n      typeSpeed = isDeleting ? 40 : 80;\n      setTimeout(type, typeSpeed);\n    }\n    type();\n\n    // 粒子背景\n    const canvas = document.getElementById('particles-canvas');\n    if (!canvas) return;\n    const ctx = canvas.getContext('2d');\n    let particles = [];\n    let animationId;\n    let mouse = { x: null, y: null };\n\n    function resizeCanvas() {\n      const wrapper = canvas.parentElement;\n      canvas.width = wrapper.offsetWidth;\n      canvas.height = wrapper.offsetHeight;\n    }\n    resizeCanvas();\n    window.addEventListener('resize', resizeCanvas);\n\n    canvas.addEventListener('mousemove', function(e) {\n      const rect = canvas.getBoundingClientRect();\n      mouse.x = e.clientX - rect.left;\n      mouse.y = e.clientY - rect.top;\n    });\n    canvas.addEventListener('mouseleave', function() {\n      mouse.x = null;\n      mouse.y = null;\n    });\n\n    class Particle {\n      constructor() {\n        this.x = Math.random() * canvas.width;\n        this.y = Math.random() * canvas.height;\n        this.vx = (Math.random() - 0.5) * 0.6;\n        this.vy = (Math.random() - 0.5) * 0.6;\n        this.radius = Math.random() * 2 + 0.8;\n        this.baseX = this.x;\n        this.baseY = this.y;\n      }\n      update() {\n        this.x += this.vx;\n        this.y += this.vy;\n        if (this.x < 0 || this.x > canvas.width) this.vx *= -1;\n        if (this.y < 0 || this.y > canvas.height) this.vy *= -1;\n\n        // 鼠标交互\n        if (mouse.x != null) {\n          const dx = mouse.x - this.x;\n          const dy = mouse.y - this.y;\n          const dist = Math.sqrt(dx * dx + dy * dy);\n          if (dist < 120) {\n            const force = (120 - dist) / 120;\n            this.vx -= (dx / dist) * force * 0.02;\n            this.vy -= (dy / dist) * force * 0.02;\n          }\n        }\n\n        // 速度限制\n        const speed = Math.sqrt(this.vx * this.vx + this.vy * this.vy);\n        if (speed > 1.5) {\n          this.vx = (this.vx / speed) * 1.5;\n          this.vy = (this.vy / speed) * 1.5;\n        }\n      }\n      draw() {\n        ctx.beginPath();\n        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);\n        ctx.fillStyle = 'rgba(150, 150, 150, 0.35)';\n        ctx.fill();\n      }\n    }\n\n    function initParticles() {\n      particles = [];\n      const count = Math.min(Math.floor(canvas.width * canvas.height / 18000), 80);\n      for (let i = 0; i < count; i++) {\n        particles.push(new Particle());\n      }\n    }\n    initParticles();\n\n    function animateParticles() {\n      ctx.clearRect(0, 0, canvas.width, canvas.height);\n      particles.forEach(p => {\n        p.update();\n        p.draw();\n      });\n\n      for (let i = 0; i < particles.length; i++) {\n        for (let j = i + 1; j < particles.length; j++) {\n          const dx = particles[i].x - particles[j].x;\n          const dy = particles[i].y - particles[j].y;\n          const dist = Math.sqrt(dx * dx + dy * dy);\n          if (dist < 130) {\n            ctx.beginPath();\n            ctx.moveTo(particles[i].x, particles[i].y);\n            ctx.lineTo(particles[j].x, particles[j].y);\n            ctx.strokeStyle = `rgba(150, 150, 150, ${0.12 * (1 - dist / 130)})`;\n            ctx.lineWidth = 0.8;\n            ctx.stroke();\n          }\n        }\n        // 与鼠标的连线\n        if (mouse.x != null) {\n          const dx = particles[i].x - mouse.x;\n          const dy = particles[i].y - mouse.y;\n          const dist = Math.sqrt(dx * dx + dy * dy);\n          if (dist < 150) {\n            ctx.beginPath();\n            ctx.moveTo(particles[i].x, particles[i].y);\n            ctx.lineTo(mouse.x, mouse.y);\n            ctx.strokeStyle = `rgba(150, 150, 150, ${0.15 * (1 - dist / 150)})`;\n            ctx.lineWidth = 0.6;\n            ctx.stroke();\n          }\n        }\n      }\n      animationId = requestAnimationFrame(animateParticles);\n    }\n    animateParticles();\n\n    document.addEventListener('visibilitychange', () => {\n      if (document.hidden) {\n        cancelAnimationFrame(animationId);\n      } else {\n        animateParticles();\n      }\n    });\n  })();\n</script>\n","updated":"2026-05-28T03:09:35.690Z